{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "supplement-store",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    // Enable Node.js APIs
    "nodejs_compat",
    // Allow fetch() to public URLs only
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match "name" above
      "service": "supplement-store",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supplement-store-db",
      "database_id": "e1253631-72d3-4a14-8e11-4289671e40aa",
      // Drizzle Kit writes migrations here; wrangler applies them
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      // Product images, review images, how-to video
      "binding": "MEDIA",
      "bucket_name": "supplement-store-media",
    },
  ],
  "images": {
    // Image optimization for next/image
    "binding": "IMAGES",
  },
  // Non-secret config. Local values in .dev.vars override these.
  // Secrets (BETTER_AUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD) go in via `wrangler secret put`.
  "vars": {
    "BETTER_AUTH_URL": "https://supplement-store.abdohafez731.workers.dev",
  },
  "observability": {
    "enabled": true,
  },
}
